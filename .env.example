# Demo mode is the default. Set MODEL_PROVIDER=openai-compatible explicitly to use Groq.
# Set this explicitly to demo to force deterministic synthetic mode.
MODEL_PROVIDER=demo
MODEL_NAME=
MODEL_API_KEY=
# OpenAI-compatible endpoint or hosted Ollama Cloud endpoint.
MODEL_BASE_URL=
# Local Ollama: set MODEL_PROVIDER=ollama-local and use http://127.0.0.1:11434.
# MODEL_API_KEY is not used in this mode.
# Anthropic Messages API is supported with provider=anthropic.
ANTHROPIC_API_VERSION=2023-06-01
MAX_MODEL_CALLS_PER_RUN=24
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_TIMEOUT_SECONDS=30
# Restrict a local copy to Ollama local inference:
# blocks Jira settings, external model consent, model council and judge profiles.
PRIVATE_LOCAL_MODE=false
# Explicit local approval before company ticket text is sent to a model API.
ALLOW_EXTERNAL_TICKET_INFERENCE=false
# Optional distinct second proposal model for the model council.
COUNCIL_PROVIDER=
COUNCIL_MODEL=
COUNCIL_API_KEY=
COUNCIL_BASE_URL=
COUNCIL_API_KEY_SCOPE=
ALLOW_COUNCIL_EXTERNAL_TICKET_INFERENCE=false
COUNCIL_CONSENT_SCOPE=
# Independent blind judge model for the optional three-model council.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_API_KEY_SCOPE=
ALLOW_JUDGE_EXTERNAL_TICKET_INFERENCE=false
JUDGE_CONSENT_SCOPE=
# Optional Jira Service Management Cloud queue connector.
# Configure locally; never paste tokens into chat or commit them.
JSM_BASE_URL=
JSM_USER_EMAIL=
JSM_API_TOKEN=
JSM_SERVICE_DESK_ID=
JSM_QUEUE_ID=
# Server-side queue monitoring runs only while the API process is running.
JSM_POLL_INTERVAL_SECONDS=60
# Optional: automatically build a review-only workflow for newly detected tickets.
JSM_AUTO_TRIAGE_NEW_TICKETS=false
# At most this many newest arrivals receive an automatic workflow per poll (1–10).
JSM_AUTO_TRIAGE_MAX_PER_POLL=5
# Experimental remote runner auth (disabled unless explicitly enabled).
# When enabled, all /api routes require an issued workspace/runner session.
SUPPORT_RUNNER_AUTH_ENABLED=false
SUPPORT_WORKSPACE_ID=
SUPPORT_RUNNER_ID=
SUPPORT_CONTROL_PLANE_API_URL=
# Optional enrollment credential for metadata-only control-plane heartbeats.
# Configure only after enrolling this runner; keep the raw value in the ignored local .env.
SUPPORT_CONTROL_PLANE_RUNNER_TOKEN=
SUPPORT_RUNNER_HEARTBEAT_INTERVAL_SECONDS=60
SUPPORT_RUNNER_SESSION_ISSUER=
SUPPORT_RUNNER_SESSION_JWKS_URI=
SUPPORT_RUNNER_ALLOWED_HOSTS=
SUPPORT_RUNNER_ALLOWED_ORIGINS=
# Keep a random per-workspace secret (at least 32 bytes) stable to preserve
# pseudonymous actor identity continuity across runner restarts.
SUPPORT_RUNNER_AUDIT_HASH_KEY=
# Allow the support UI origin to call the control-plane API when remote auth is enabled.
CONTROL_PLANE_ALLOWED_ORIGINS=
# Optional local support guidance (.md/.txt only).
# The directory must include .support-workflow-approved-sources.json. Each entry
# needs a relative path, approved status, owner reference, date and evidence ref.
# Unlisted files are never indexed.
# When KNOWLEDGE_PROVIDER=local, Jira triage is blocked until this manifest
# lists at least one readable file. Confluence can be selected separately in UI.
KNOWLEDGE_DIR=
# Knowledge provider is local by default. The UI can select Confluence Cloud.
KNOWLEDGE_PROVIDER=local
# Optional read-only Confluence Cloud knowledge source. Keep API tokens local.
CONFLUENCE_BASE_URL=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_API_TOKEN_SCOPE=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_TICKET_SEARCH_ALLOWED=false
CONFLUENCE_SEARCH_CONSENT_SCOPE=
# GitHub code-change workflow is not implemented yet. Do not add a token here.
# The target repository and validation commands will be configured before wiring it.
